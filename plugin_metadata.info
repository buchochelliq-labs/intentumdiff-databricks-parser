# Bundled parser metadata for the IntentumDiff language-info API.
# Plugin code exposes this data; the host still owns trust and provenance.

[plugin]
author = IntentumDiff
plugin_version = 0.1.0
last_updated = 2026-05-19

[language.databricks-workflow]
language_name = Databricks Workflow
language_short_name = Databricks Workflow
monaco_language = yaml
default_filename = workflow.yml
language_file_extensions = .yml, .yaml

[language.databricks]
language_name = Databricks
language_short_name = Databricks
monaco_language = plaintext
default_filename = notebook.py
language_file_extensions = .py, .sql
